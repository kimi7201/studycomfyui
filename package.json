{
  "name": "studycomfyui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StudyComfyUI：让 ComfyUI 学习者看懂工作流、学会改节点的开源学习工作台",
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "docs:dev": "vitepress dev docs --port 5174",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 5174"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.5",
    "vitepress": "^1.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
